# Copy this file to .env before running Docker Compose. Do not commit .env.
POSTGRES_DB=flocksense
POSTGRES_USER=flocksense
POSTGRES_PASSWORD=replace-with-a-long-unique-password
JWT_SECRET=replace-with-a-long-random-jwt-signing-secret
APP_PORT=80

# The current ledger implementation is a mock adapter. Set this to the name
# of the production chain only after a production adapter has been configured.
CHAIN=mock-vechain
